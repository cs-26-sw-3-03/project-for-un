import javax.swing.*;
import java.awt.*;
import java.util.*;

public class ProductDetailsPage extends JPanel {
  private static HashMap<String, java.awt.Color> themeColors = CustomTheme.getTheme();

  public ProductDetailsPage(int int_id) {
    setLayout(new BorderLayout());
    setBackground(themeColors.get("primær_baggrund"));
    
    HashMap<Attribute, String> attributeMap = new HashMap<>();

    Product product;
    try {
      product = ProductQuerier.GetProduct(int_id);
    } catch(java.sql.SQLException e) {
      System.out.println(e);
      return;
    }

    System.out.println(product);

    for (Attribute attribute : Attribute.values()) {
      Object value = product.GetObject(attribute);
      attributeMap.put(attribute, value == null ? "null" : value.toString());
    }

    JPanel tempPanel = new JPanel(new GridLayout(10, 4));

    for (Attribute attribute : Attribute.values()) {
      JPanel subPanel = new JPanel(new GridLayout(1,2));
      JLabel l = new JLabel(AttributeDescriber.DkNameOf(attribute));
      l.setBorder(BorderFactory.createMatteBorder(1,1,1,1,Color.GRAY));
      l.setForeground(themeColors.get("accent_color"));
      l.setOpaque(true);
      JTextField f = new JTextField(attributeMap.get(attribute));
      f.setEditable(false);
      subPanel.add(l);
      subPanel.add(f);
      tempPanel.add(subPanel);
    }

    add(tempPanel);
  }
}
